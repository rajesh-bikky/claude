DATABASE_URL="file:./dev.db"

# Only needed in production (e.g. Vercel + Turso) — falls back to the local
# SQLite file above when unset. Provisioned automatically by the Turso
# integration in the Vercel dashboard.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Google Gemini API key (free tier, no credit card — console.ai.dev / aistudio.google.com),
# used to categorize transcripts into to-dos / ideas / thoughts
GEMINI_API_KEY=""

# Auth.js session encryption key — generate with `npx auth secret`
AUTH_SECRET=""

# From a Google Cloud OAuth 2.0 Client ID (console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only this email is allowed to sign in
ALLOWED_EMAIL=""

# Shared secret for the local spin-off watcher script (scripts/spinoff-watcher.mjs)
# — generate any long random string, it just needs to match on both ends
WATCHER_SECRET=""
